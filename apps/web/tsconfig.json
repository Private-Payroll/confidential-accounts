{
  /*
   * THE NEW PAYROLL APPLICATION'S TYPECHECK.
   *
   * Its own file, like the wallet's, so the application's DOM types, its JSX
   * and its settings stay out of every other config. The strictness is the
   * wallet's and is repeated rather than inherited, because a config that
   * reaches out of its own folder for settings behaves differently depending
   * on where it sits.
   */
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../dist/declarations/apps/web/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "jsx": "react-jsx",
    /*
     * The kit by its name, to its source, the way the kit's own typecheck
     * reaches it. The kit's package exports its files without extensions,
     * which the bundler resolves and the typechecker, reading the exports,
     * does not.
     */
    "paths": {
      "vaults-ui": ["../../packages/ui/src/index.ts"],
      "vaults-ui/*": ["../../packages/ui/src/*"]
    }
  },
  /*
   * The shared browser code is read through its declarations, built under its
   * own settings by the config named here, and never re-checked from source
   * under this application's stricter ones: a file this application does not
   * own is not held to rules its own package does not keep. Building this
   * config (`tsc -b --force`) builds that one first, in full; the record of
   * what was built is kept beside the declarations, under `dist/`.
   */
  "references": [{ "path": "./tsconfig.web-shared.json" }],
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
