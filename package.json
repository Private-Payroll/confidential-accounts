{
  "name": "midnight-accounts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
  "test:checks": "node --test .github/checks/commit.test.mjs .github/checks/toolchain.test.mjs && node .github/checks/watch-rules-refuse.mjs",
    "api": "tsx src/server/index.ts",
    "web": "vite",
    "dev": "ALLOW_SIMULATED_COMPANY_ADDRESS=1 VITE_ALLOW_LOCALHOST_ORIGIN=1 APP_ORIGIN=http://localhost:5173 WALLET_ORIGIN=http://localhost:5180 VITE_WALLET_ORIGIN=http://localhost:5180 VITE_DEV_ERROR_SINK=1 ALLOW_WEB_CONSOLE_SINK=1 tsx scripts/serve.ts",
    "standalone": "vite build --config vite.standalone.config.ts",
    "compact": "./scripts/compile-contract.sh --full",
    "compact:fast": "./scripts/compile-contract.sh",
  "compact:vault": "./scripts/compile-vault.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:identity": "tsc --noEmit -p packages/identity/tsconfig.json",
    "typecheck:wallet": "tsc --noEmit -p apps/wallet/tsconfig.json",
    "pretest": "npm run compact:fast && npm run typecheck:scripts && npm run typecheck && npm run typecheck:identity && npm run typecheck:wallet",
    "wallet": "VITE_ALLOW_LOCALHOST_ORIGIN=1 VITE_APP_ORIGIN=http://localhost:5173 vite --config apps/wallet/vite.config.ts",
    "wallet:build": "vite build --config apps/wallet/vite.config.ts",
    "identity:build": "tsc -p packages/identity/tsconfig.build.json",
    "vendor-keys": "node apps/wallet/scripts/vendor-keys.mjs",
    "deploy": "tsx scripts/deploy-preview.ts",
    "preflight": "node scripts/preflight-preview.mjs",
    "migrate": "tsx scripts/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "midnight-identity": "file:./packages/identity",
    "@midnight-ntwrk/compact-js": "2.5.5-rc.6",
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0-beta.4",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/wallet-sdk": "2.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "express": "5.2.1",
    "nanoid": "6.0.1",
    "playwright": "1.63.0",
    "rollup": "^4.62.4",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "zod": "4.6.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "5.0.0-beta.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "private": true,
  "overrides": {
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnight-ntwrk/compact-runtime": "0.19.0"
  }
