pragma language_version 0.26.0;
import CompactStandardLibrary;

/*
 * THE VAULT. It holds a company's money and decides nothing.
 *
 * It holds two kinds side by side: private notes, recorded here only as
 * commitments in `notes`, and public money, whose balance the chain itself
 * keeps. Every payment out asks the company's account, naming this vault, and
 * mints one unit of this vault's own receipt token to the account in the same
 * call, so the account records a payment only when this vault really made one.
 * Every other change to the vault's money or its secret - splitting a note,
 * setting the nonce secret - is approved the same way and recorded by the
 * account as no payment.
 *
 * Every coin it makes takes a nonce worked out here from the spent note's
 * nullifier, never one the caller chose, so no caller can make a coin the
 * company cannot name. Money is accepted only once the account has adopted the
 * vault and approved its first nonce secret.
 *
 * A payment, or a batch of up to four payees approved together, may draw on
 * several held notes of its token, and returns one coin of change; a merge
 * combines held notes into one, needs no approval and sends nothing out.
 *
 * It refuses a note it does not hold, a note of the wrong token, notes that
 * together hold too little, a payment of nothing, a merge of fewer than two
 * notes, a public payment it cannot cover, a deposit of nothing, any deposit
 * before its first secret, a secret that is zero, repeated or does
 * not follow the one it replaces, a secret set by a caller who does not hold it
 * or, once the vault has taken money, the last secret it took money under, a
 * secret whose last byte is not zero, a tree of copies holding a copy past its
 * count, a sealed copy the secret run did not approve, and, in its own
 * `retire`, retirement while it still holds either kind of money.
 *
 * Each new secret carries the last secret the vault took money under, sealed
 * under itself, so a signer given only the newest secret can open every earlier
 * secret that took money and name every note the vault still holds, while a
 * signer who left, holding only earlier secrets, opens nothing newer.
 *
 * Why each piece is shaped this way: docs/design/the-vault-contract.md
 */

// One level of a payee's path in a run's sum tree, as the account defines it.
struct SumStep {
  sibling: Field;
  siblingSum: Uint<128>;
  goesLeft: Boolean;
}

// One place in a batch, declared exactly as the account declares it: whether it pays anyone, the
// payee's blinded details and nonce, and the amount. An unused place carries nothing.
struct BatchSlot {
  live: Boolean;
  details: Bytes<32>;
  nonce: Bytes<32>;
  amount: Uint<128>;
}

// The account this vault answers to, and the only calls a vault may make to it.
contract Acct {
  // Approves and records one payee's payment against this vault's receipt, or fails the transaction.
  circuit recordPaymentFromVault(
    proposal: Bytes<32>,
    runVault: Bytes<32>,
    payingVault: Bytes<32>,
    root: Bytes<32>,
    payees: Uint<64>,
    opensAt: Uint<64>,
    closesAt: Uint<64>,
    required: Uint<64>,
    salt: Bytes<32>,
    details: Bytes<32>,
    nonce: Bytes<32>,
    amount: Uint<128>,
    asset: Bytes<32>,
    path: Vector<16, SumStep>,
  ): ContractAddress;

  // Approves one change to this vault that moves no money, against its own receipt, and records no payment.
  circuit approveVaultChange(
    proposal: Bytes<32>,
    runVault: Bytes<32>,
    payingVault: Bytes<32>,
    root: Bytes<32>,
    payees: Uint<64>,
    opensAt: Uint<64>,
    closesAt: Uint<64>,
    required: Uint<64>,
    salt: Bytes<32>,
    details: Bytes<32>,
    nonce: Bytes<32>,
    asset: Bytes<32>,
    path: Vector<16, SumStep>,
  ): ContractAddress;

  // Approves and records a batch of up to four payees of an approved run against one receipt, or
  // fails the transaction.
  circuit recordBatchFromVault(
    proposal: Bytes<32>,
    runVault: Bytes<32>,
    payingVault: Bytes<32>,
    root: Bytes<32>,
    payees: Uint<64>,
    opensAt: Uint<64>,
    closesAt: Uint<64>,
    required: Uint<64>,
    salt: Bytes<32>,
    slots: Vector<4, BatchSlot>,
    asset: Bytes<32>,
    path: Vector<16, SumStep>,
  ): ContractAddress;

  // Takes this vault off the account's register, under an approved retire proposal.
  circuit retireVault(
    proposal: Bytes<32>,
    vault: Bytes<32>,
    salt: Bytes<32>,
  ): [];
}

// One run's arguments, as the account checks them, apart from the payee's own.
struct Run {
  proposal: Bytes<32>;
  runVault: Bytes<32>;
  root: Bytes<32>;
  payees: Uint<64>;
  opensAt: Uint<64>;
  closesAt: Uint<64>;
  required: Uint<64>;
  salt: Bytes<32>;
  nonce: Bytes<32>;
  asset: Bytes<32>;
  path: Vector<16, SumStep>;
}

// What a coin's commitment and nullifier are taken over, as the ledger takes them.
struct CoinPreimage {
  domain_sep: Bytes<21>;
  info: ShieldedCoinInfo;
  dataType: Boolean;
  data: Bytes<32>;
}

// Written once, by the constructor. No circuit writes it.
export ledger account: Acct;

// The private notes this vault holds, as commitments. The notes stay on the owner's device.
export ledger notes: Set<Bytes<32>>;

// Public tokens this vault may still hold: added on deposit, dropped by `forgetUnshielded`.
export ledger unshieldedTokens: Set<Bytes<32>>;

// How many payments this vault has made, a batch counting once. Public. A split, a merge and a
// secret run add nothing.
export ledger payments: Counter;

// Reserved, as the six below are. No circuit reads or writes it. A vault has no spending
// cap: the company account checks every limit, once per run.
export ledger reserved0: Map<Bytes<32>, Bytes<32>>;

// The commitment to the vault's current nonce secret. Zero until the first approved secret run.
export ledger nonceCommitment: Bytes<32>;

// One masked amount per split, keyed by the spent note's nullifier.
export ledger splitJournal: Map<Bytes<32>, Bytes<32>>;

// Each signer's sealed copy of each secret, the approved root of each secret's copies and how
// many are still to be written, and this vault's two receipt tokens, worked out once by the
// first secret run.
export ledger secretCopies: Map<Bytes<32>, Bytes<32>>;

// Reserved for later features. No circuit reads or writes them.
export ledger reserved1: Map<Bytes<32>, Bytes<32>>;
export ledger reserved2: Map<Bytes<32>, Bytes<32>>;
export ledger reserved3: Map<Bytes<32>, Bytes<32>>;
export ledger reserved4: Map<Bytes<32>, Bytes<32>>;
export ledger reserved5: Map<Bytes<32>, Bytes<32>>;
export ledger reserved6: Map<Bytes<32>, Bytes<32>>;

// The note to spend, chosen on the owner's device. Untrusted: every reader checks it.
witness noteToSpend(token: Bytes<32>, amount: Uint<128>): QualifiedShieldedCoinInfo;

// The vault's current nonce secret, from the signer's device. Checked against `nonceCommitment`.
witness nonceSecret(): Bytes<32>;

// Pins the account.
constructor(a: Acct) {
  account = disclose(a);
}

// A private payment's recipient, token and amount, committed under a blinding.
export circuit payoutDetails(
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [recipient, token, amount as Field as Bytes<32>], blinding);
}

// The same for public money, tagged so an approval for one kind cannot settle the other.
export circuit unshieldedPayoutDetails(
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<4, Bytes<32>>>(
    [pad(32, "midnight-vault:unshielded:"),
     recipient, token, amount as Field as Bytes<32>], blinding);
}

// What the pool records for a note: its nonce, token and amount, not its tree position.
export circuit heldCommitmentOf(coin: ShieldedCoinInfo, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<ShieldedCoinInfo>(coin, blinding);
}

// Every note's blinding: this vault's address, so nobody chooses it. The coin's own nonce is
// what keeps the commitment from being opened by anyone who does not know the coin.
export circuit noteBlindingOf(vault: Bytes<32>, coin: ShieldedCoinInfo): Bytes<32> {
  return vault;
}

// A note's nullifier as the ledger computes it for a coin this vault owns.
export circuit noteNullifierOf(vault: Bytes<32>, coin: ShieldedCoinInfo): Bytes<32> {
  return persistentHash<CoinPreimage>(CoinPreimage {
    domain_sep: "midnight:zswap-cn[v1]", info: coin, dataType: false, data: vault,
  });
}

// A coin's commitment as the ledger computes it, to a person's key or to this vault.
export circuit coinCommitmentOf(coin: ShieldedCoinInfo, owner: Bytes<32>, toPerson: Boolean): Bytes<32> {
  return persistentHash<CoinPreimage>(CoinPreimage {
    domain_sep: "midnight:zswap-cc[v1]", info: coin, dataType: toPerson, data: owner,
  });
}

// A new coin's nonce: a tag, the vault's secret and the spent note's nullifier, so it is fixed
// by the note spent and nobody without the secret can work it out. The nullifier is public, so
// without the secret anyone could rebuild the nonce and find the coin's value by trying amounts.
export circuit freshNonceOf(tag: Bytes<32>, secret: Bytes<32>, spent: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([tag, secret, spent]);
}

// The tags a new coin's nonce is made under, one per kind of coin.
export circuit payeeNonceTag(): Bytes<32> { return pad(32, "midnight-vault:nonce:payee"); }
export circuit changeNonceTag(): Bytes<32> { return pad(32, "midnight-vault:nonce:change"); }
export circuit splitNonceTag(): Bytes<32> { return pad(32, "midnight-vault:nonce:split"); }
export circuit restNonceTag(): Bytes<32> { return pad(32, "midnight-vault:nonce:rest"); }

// The token this vault mints to the account with a payment, and the one it mints with a change.
export circuit paymentReceiptTag(): Bytes<32> { return pad(32, "midnight-accounts:receipt:pay"); }
export circuit changeReceiptTag(): Bytes<32> { return pad(32, "midnight-accounts:receipt:change"); }

// The commitment to a nonce secret, bound to this vault, so two vaults' commitments never match.
export circuit secretCommitmentOf(vault: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "midnight-vault:nonce-secret:"), vault, secret]);
}

// What signers approve to set the secret: a tag and a hash, never the shape of a payment's details.
export circuit secretRunDetails(
  vault: Bytes<32>,
  previous: Bytes<32>,
  commitment: Bytes<32>,
  copies: Bytes<32>,
  count: Uint<64>,
): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:secret-run:"),
    persistentHash<Vector<5, Bytes<32>>>([vault, previous, commitment, copies, count as Field as Bytes<32>])]);
}

// What signers approve to split one note: the note, by its nullifier, and the piece cut from it.
export circuit splitDetails(
  vault: Bytes<32>,
  spent: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:split:"),
    persistentHash<Vector<4, Bytes<32>>>([vault, spent, token, amount as Field as Bytes<32>])]);
}

// One level of a sealed copy's path in the approved tree of copies: the node beside it, and
// whether the copy's side is the left one at that level.
struct CopyStep {
  sibling: Field;
  goesLeft: Boolean;
}

// The leaf one signer's sealed copy of a secret makes in the approved tree of copies.
export circuit copyLeafOf(
  commitment: Bytes<32>,
  reader: Bytes<32>,
  parts: Vector<4, Bytes<32>>,
): Field {
  return degradeToTransient(persistentHash<Vector<7, Bytes<32>>>([pad(32, "midnight-vault:secret-copy-leaf:"),
    commitment, reader, parts[0], parts[1], parts[2], parts[3]]));
}

// One node of the tree of copies, from the two below it.
export circuit copyNodeOf(left: Field, right: Field): Field {
  return transientHash<Vector<2, Field>>([left, right]);
}

// The root a copy's leaf and its path lead to. Ten levels, as deep as the account's own signer tree.
export circuit copiesRootOf(leaf: Field, path: Vector<10, CopyStep>): Bytes<32> {
  return upgradeFromTransient(fold((node: Field, step: CopyStep): Field =>
    step.goesLeft ? copyNodeOf(node, step.sibling) : copyNodeOf(step.sibling, node), leaf, path));
}

// The place in the tree a copy's path leads to, read from its left-right flags.
export circuit copyIndexOf(path: Vector<10, CopyStep>): Uint<64> {
  return (
    (path[0].goesLeft ? 0 : 1) +
    (path[1].goesLeft ? 0 : 2) +
    (path[2].goesLeft ? 0 : 4) +
    (path[3].goesLeft ? 0 : 8) +
    (path[4].goesLeft ? 0 : 16) +
    (path[5].goesLeft ? 0 : 32) +
    (path[6].goesLeft ? 0 : 64) +
    (path[7].goesLeft ? 0 : 128) +
    (path[8].goesLeft ? 0 : 256) +
    (path[9].goesLeft ? 0 : 512)
  ) as Uint<64>;
}

// The most copies one secret's tree holds.
export circuit mostCopies(): Uint<64> { return 1024; }

// Where one part of a sealed copy sits: the secret's commitment, the reader's key, the copy's
// place in the tree and the part. The place keeps two entries for one reader apart.
export circuit copyKeyOf(commitment: Bytes<32>, reader: Bytes<32>, place: Uint<64>, part: Uint<8>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([pad(32, "midnight-vault:secret-copy:"),
    commitment, reader, place as Field as Bytes<32>, part as Field as Bytes<32>]);
}

// Where the vault marks the last secret whose copies were all written while it was current:
// the last secret it opened to money under.
export circuit copiesWrittenKey(): Bytes<32> { return pad(32, "midnight-vault:copies-written"); }

// Where the approved root of a secret's copies sits.
export circuit copiesRootKeyOf(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:copies-root:"), commitment]);
}

// Where the number of a secret's copies still to be written sits.
export circuit copiesLeftKeyOf(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:copies-left:"), commitment]);
}

// Where the number of copies a secret run approved sits. Written once and never changed, so the
// chain shows how many copies a secret has after every one of them is written.
export circuit copiesCountKeyOf(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:copies-count:"), commitment]);
}

// The walk up the tree of copies from the first place past the count: the node so far, the
// empty subtree at this level, and whether every subtree to the right so far is empty.
struct EdgeWalk {
  node: Field;
  empty: Field;
  clear: Boolean;
}

// Whether every place from `count` on is empty in the tree whose root is `copies`: `edge` leads
// from an empty place at `count` to that root, and every subtree to its right is empty. Then no
// copy sits past the count, so a count smaller than the copies the tree holds cannot open the
// vault with a copy missing. A tree of every place full needs no edge.
export circuit emptyFrom(copies: Bytes<32>, count: Uint<64>, edge: Vector<10, CopyStep>): Boolean {
  const walk = fold((w: EdgeWalk, step: CopyStep): EdgeWalk => EdgeWalk {
      node: step.goesLeft ? copyNodeOf(w.node, step.sibling) : copyNodeOf(step.sibling, w.node),
      empty: copyNodeOf(w.empty, w.empty),
      clear: w.clear && (!step.goesLeft || step.sibling == w.empty),
    }, EdgeWalk { node: 0 as Field, empty: 0 as Field, clear: true }, edge);
  return count == mostCopies() ||
    (walk.clear && copyIndexOf(edge) == count && upgradeFromTransient(walk.node) == copies);
}

// Whether a secret has the shape every nonce secret takes: its last byte zero, so it is one
// field element exactly and a later secret can carry it.
export circuit isNonceSecretShape(secret: Bytes<32>): Boolean {
  return upgradeFromTransient(degradeToTransient(secret)) == secret;
}

// Where the secret a later one carries is kept, sealed under the later one.
export circuit earlierSecretKeyOf(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:earlier-secret:"), commitment]);
}

// The mask a secret puts over the one it replaces. Only a holder of the later secret can lift it.
export circuit earlierMaskOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "midnight-vault:earlier-mask:"), secret]);
}

// The earlier secret as the vault keeps it: added to the later secret's mask, as field elements,
// and kept as all thirty-two bytes of the sum, which can need more than thirty-one.
export circuit sealedEarlierOf(earlier: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return (degradeToTransient(earlier) + degradeToTransient(earlierMaskOf(secret))) as Bytes<32>;
}

// The earlier secret from what the vault keeps and the later secret.
export circuit earlierSecretOf(kept: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return upgradeFromTransient((kept as Field) - degradeToTransient(earlierMaskOf(secret)));
}

// The mask on a split's amount: it needs the secret and the note, so only the company can lift it.
export circuit splitMaskOf(secret: Bytes<32>, spent: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "midnight-vault:split-mask:"), secret, spent]);
}

// A split's amount as the journal holds it: added to the mask, as field elements.
export circuit maskedAmountOf(amount: Uint<128>, mask: Bytes<32>): Bytes<32> {
  return upgradeFromTransient((amount as Field) + degradeToTransient(mask));
}

// Where this vault's receipt tokens are kept once worked out. No commitment, copy or list key can equal them.
export circuit paymentReceiptKey(): Bytes<32> { return pad(32, "midnight-vault:receipt:pay"); }
export circuit changeReceiptKey(): Bytes<32> { return pad(32, "midnight-vault:receipt:change"); }

// Mints one unit of a receipt token kept by the first secret run to the account.
circuit mintReceipt(tag: Bytes<32>, key: Bytes<32>, acct: ContractAddress): [] {
  kernel.mintUnshielded(tag, 1);
  // The colour was worked out in a proof of this vault's own circuit; one that did not match
  // the mint would leave the token unbalanced and the whole transaction refused.
  kernel.claimUnshieldedCoinSpend(left<Bytes<32>, Bytes<32>>(secretCopies.lookup(key)),
    left<ContractAddress, UserAddress>(acct), 1);
}

// A split's amount from its journal entry and its mask: what a device holding the secret recovers.
export circuit unmaskedAmountOf(masked: Bytes<32>, mask: Bytes<32>): Field {
  return degradeToTransient(masked) - degradeToTransient(mask);
}

// Refuses money and every change until the account has approved this vault's first secret,
// and until every signer's sealed copy of the current secret is on the chain: a coin made
// under a secret nobody else can open would be lost with the device that holds it.
circuit requireStarted(): [] {
  assert(!(nonceCommitment == default<Bytes<32>>),
    "this vault takes no money yet: the company's account has not adopted it and approved its first nonce secret");
  assert(secretCopies.lookup(copiesWrittenKey()) == nonceCommitment,
    "this vault takes no money yet: not every signer's sealed copy of its secret is on the chain");
}

// The vault's current secret, checked against its commitment.
circuit currentSecret(): Bytes<32> {
  requireStarted();
  const s = nonceSecret();
  assert(nonceCommitment == secretCommitmentOf(kernel.self().bytes, s),
    "that is not this vault's current nonce secret");
  return s;
}

// Takes a held note out of the pool and spends it. Returns its nullifier.
circuit spendHeld(coin: QualifiedShieldedCoinInfo): Bytes<32> {
  const self = kernel.self();
  const unqualified = ShieldedCoinInfo { nonce: coin.nonce, color: coin.color, value: coin.value };
  return spendHeldAs(coin, disclose(noteNullifierOf(self.bytes, unqualified)));
}

// The same, for a caller that has already worked out the note's nullifier.
circuit spendHeldAs(coin: QualifiedShieldedCoinInfo, spent: Bytes<32>): Bytes<32> {
  const self = kernel.self();
  const unqualified = ShieldedCoinInfo { nonce: coin.nonce, color: coin.color, value: coin.value };
  const held = disclose(heldCommitmentOf(unqualified, noteBlindingOf(self.bytes, unqualified)));
  assert(notes.member(held), "that note is not in this vault's pool");
  // Removed before anything is made from it, so one note cannot fund two things.
  notes.remove(held);
  createZswapInput(coin);
  kernel.claimZswapNullifier(spent);
  return spent;
}

// Makes one coin for a recipient outside this vault.
circuit sendCoin(coin: ShieldedCoinInfo, to: Bytes<32>): [] {
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey { bytes: to });
  createZswapOutput(coin, recipient);
  kernel.claimZswapCoinSpend(coinCommitmentOf(coin, to, true));
}

// Makes one coin for this vault and adds it to the pool.
circuit keepCoin(coin: ShieldedCoinInfo): [] {
  const self = kernel.self();
  createZswapOutput(coin, right<ZswapCoinPublicKey, ContractAddress>(self));
  const cm = coinCommitmentOf(coin, self.bytes, false);
  kernel.claimZswapCoinSpend(cm);
  kernel.claimZswapCoinReceive(cm);
  notes.insert(disclose(heldCommitmentOf(coin, noteBlindingOf(self.bytes, coin))));
}

// Asks the account to approve a change that moves no money. Returns the account's address.
circuit askForChange(run: Run, details: Bytes<32>): ContractAddress {
  return account.approveVaultChange(
    disclose(run.proposal),
    disclose(run.runVault),
    disclose(kernel.self().bytes),
    disclose(run.root),
    disclose(run.payees),
    disclose(run.opensAt),
    disclose(run.closesAt),
    disclose(run.required),
    disclose(run.salt),
    disclose(details),
    disclose(run.nonce),
    disclose(run.asset),
    disclose(run.path));
}

// Accepts a private note of any token from anyone, once the vault has its first secret.
export circuit deposit(coin: ShieldedCoinInfo): [] {
  requireStarted();
  assert(!(disclose(coin.value) == 0), "a deposit of nothing is not a deposit");
  receiveShielded(disclose(coin));
  notes.insert(disclose(heldCommitmentOf(coin, noteBlindingOf(kernel.self().bytes, coin))));
}

// Accepts public money from anyone, once the vault has its first secret. Refuses nothing.
export circuit depositUnshielded(token: Bytes<32>, amount: Uint<128>): [] {
  requireStarted();
  assert(!(amount == 0), "a deposit of nothing is not a deposit");
  receiveUnshielded(disclose(token), disclose(amount));
  unshieldedTokens.insert(disclose(token));
}

// A run's arguments for a batch, as the account checks them. A batch's own places carry what a
// single payment's run carries for its one payee.
struct BatchRun {
  proposal: Bytes<32>;
  runVault: Bytes<32>;
  root: Bytes<32>;
  payees: Uint<64>;
  opensAt: Uint<64>;
  closesAt: Uint<64>;
  required: Uint<64>;
  salt: Bytes<32>;
  path: Vector<16, SumStep>;
}

// One place in a batch as the vault pays it: whether it pays anyone, and the payee, amount,
// blinding and payee nonce the signers approved for it.
struct Pay {
  live: Boolean;
  recipient: Bytes<32>;
  amount: Uint<128>;
  blinding: Bytes<32>;
  nonce: Bytes<32>;
}

// The tag each place of a batch makes its payee's coin under, and the one a merge keeps its coin
// under. Each differs from every other kind of coin's tag.
export circuit batchPayeeNonceTag(place: Uint<8>): Bytes<32> {
  return place == 0 ? pad(32, "midnight-vault:nonce:batch-0")
    : place == 1 ? pad(32, "midnight-vault:nonce:batch-1")
    : place == 2 ? pad(32, "midnight-vault:nonce:batch-2")
    : pad(32, "midnight-vault:nonce:batch-3");
}
export circuit mergeNonceTag(): Bytes<32> { return pad(32, "midnight-vault:nonce:merge"); }

// Spends one further note offered for a step and adds what it holds. A place holding nothing is
// unused and spends nothing: no note the vault holds is worth nothing.
circuit spendFurther(token: Bytes<32>, held: Uint<128>, coin: QualifiedShieldedCoinInfo): Uint<128> {
  const live = disclose(!(coin.value == 0));
  if (live) {
    assert(coin.color == token, "every note a step spends is of the token it pays");
    spendHeld(coin);
  }
  // Cast back to 128 bits, which refuses notes that together hold more than one coin can.
  return (held + (live ? coin.value : 0)) as Uint<128>;
}

// Pays one payee of an approved run in private money. Payee, token and amount stay private. It
// draws on the note `noteToSpend` offers and, when that is not enough, on one more held note of
// the same token; one coin of the change goes back into the pool.
export circuit payout(
  run: Run,
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
  more: Vector<1, QualifiedShieldedCoinInfo>,
): [] {
  const s = currentSecret();
  assert(!(disclose(amount) == 0), "a payment of nothing records a person as paid with nobody paid");

  // The notes offered must be of this token, together big enough, and in the pool.
  const coin = noteToSpend(token, amount);
  assert(coin.color == token, "that is not a note of the token being paid");

  // The account refuses unless the run is approved for this vault, this payee is unpaid, and
  // the token and amount are the ones this call actually sends.
  const acct = account.recordPaymentFromVault(
    disclose(run.proposal),
    disclose(run.runVault),
    disclose(kernel.self().bytes),
    disclose(run.root),
    disclose(run.payees),
    disclose(run.opensAt),
    disclose(run.closesAt),
    disclose(run.required),
    disclose(run.salt),
    disclose(payoutDetails(recipient, token, amount, blinding)),
    disclose(run.nonce),
    disclose(amount),
    disclose(token),
    disclose(run.path));
  mintReceipt(paymentReceiptTag(), paymentReceiptKey(), acct);

  // Every coin this payment makes is keyed by the first note's nullifier, which the ledger
  // accepts once, so no two coins the vault makes ever share a nonce.
  const spent = spendHeld(coin);
  const held = fold((h: Uint<128>, c: QualifiedShieldedCoinInfo): Uint<128> => spendFurther(token, h, c),
    coin.value, more);
  assert(!(held < amount), "the notes offered do not hold enough to make this payment");
  sendCoin(ShieldedCoinInfo {
    nonce: disclose(freshNonceOf(payeeNonceTag(), s, spent)), color: disclose(token), value: disclose(amount)
  }, disclose(recipient));

  // Any change goes back into the pool as one new note, worked out here so none is left out.
  // Whether there is change is public: a payment that spends its notes exactly writes no note.
  const change = disclose(held) - disclose(amount);
  if (!(change == 0)) {
    keepCoin(ShieldedCoinInfo {
      nonce: disclose(freshNonceOf(changeNonceTag(), s, spent)), color: disclose(token), value: change as Uint<128>
    });
  }
  payments.increment(1);
}

// One place as the account checks it: a live place at nothing is refused, and an unused place
// carries no amount.
circuit batchSlotOf(token: Bytes<32>, p: Pay): BatchSlot {
  assert(!(p.live && p.amount == 0), "a payment of nothing records a person as paid with nobody paid");
  return BatchSlot {
    live: p.live,
    details: payoutDetails(p.recipient, token, p.amount, p.blinding),
    nonce: p.nonce,
    amount: p.live ? p.amount : 0,
  };
}

// Makes one place's payee coin, if the place pays anyone.
circuit payPlace(s: Bytes<32>, spent: Bytes<32>, token: Bytes<32>, p: Pay, place: Uint<8>): [] {
  if (disclose(p.live)) {
    sendCoin(ShieldedCoinInfo {
      nonce: disclose(freshNonceOf(batchPayeeNonceTag(place), s, spent)), color: disclose(token), value: disclose(p.amount)
    }, disclose(p.recipient));
  }
}

// Pays a batch of up to four payees of an approved run in private money, as one payment with
// one receipt. The run approved the batch as a whole: which places pay, whom, how much, in which
// token. It draws on up to three held notes of that token; one coin of the change goes back into
// the pool. How many places pay is public; who and how much stay private.
export circuit batchPayout(
  run: BatchRun,
  token: Bytes<32>,
  pays: Vector<4, Pay>,
  notes: Vector<3, QualifiedShieldedCoinInfo>,
): [] {
  const s = currentSecret();
  const slots = map((p: Pay): BatchSlot => batchSlotOf(token, p), pays);
  const total = (slots[0].amount + slots[1].amount + slots[2].amount + slots[3].amount) as Uint<128>;
  assert(!(disclose(total) == 0), "a batch pays at least one person");

  // The account refuses unless the run is approved for this vault, the batch is a leaf of it at
  // this total and token, and nobody it pays has been paid.
  const acct = account.recordBatchFromVault(
    disclose(run.proposal),
    disclose(run.runVault),
    disclose(kernel.self().bytes),
    disclose(run.root),
    disclose(run.payees),
    disclose(run.opensAt),
    disclose(run.closesAt),
    disclose(run.required),
    disclose(run.salt),
    disclose(slots),
    disclose(token),
    disclose(run.path));
  mintReceipt(paymentReceiptTag(), paymentReceiptKey(), acct);

  const first = notes[0];
  assert(first.color == token, "that is not a note of the token being paid");
  const spent = spendHeld(first);
  const held = fold((h: Uint<128>, c: QualifiedShieldedCoinInfo): Uint<128> => spendFurther(token, h, c),
    first.value, slice<2>(notes, 1));
  assert(!(held < total), "the notes offered do not hold enough to make this payment");
  payPlace(s, spent, token, pays[0], 0);
  payPlace(s, spent, token, pays[1], 1);
  payPlace(s, spent, token, pays[2], 2);
  payPlace(s, spent, token, pays[3], 3);

  const change = disclose(held) - disclose(total);
  if (!(change == 0)) {
    keepCoin(ShieldedCoinInfo {
      nonce: disclose(freshNonceOf(changeNonceTag(), s, spent)), color: disclose(token), value: change as Uint<128>
    });
  }
  payments.increment(1);
}

// Merges two to four held notes of one token into one note the vault keeps. No approval: it sends
// nothing out of the vault, every note it spends is one the pool holds, and the one coin it makes
// is the vault's own, worth exactly what they held, under a nonce only the vault's secret names.
export circuit mergeNotes(token: Bytes<32>, notes: Vector<4, QualifiedShieldedCoinInfo>): [] {
  const s = currentSecret();
  const first = notes[0];
  assert(first.color == token, "every note a step spends is of the token it pays");
  assert(disclose(!(notes[1].value == 0)), "a merge takes at least two notes");
  const spent = spendHeld(first);
  const held = fold((h: Uint<128>, c: QualifiedShieldedCoinInfo): Uint<128> => spendFurther(token, h, c),
    first.value, slice<3>(notes, 1));
  keepCoin(ShieldedCoinInfo {
    nonce: disclose(freshNonceOf(mergeNonceTag(), s, spent)), color: disclose(token), value: disclose(held)
  });
}

// Pays one payee of an approved run in public money. The amount and recipient are public.
export circuit payoutUnshielded(
  run: Run,
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
): [] {
  requireStarted();
  assert(!(amount == 0), "a payment of nothing records a person as paid with nobody paid");
  // Its own details, so a leaf approved for private money cannot be settled here.
  const acct = account.recordPaymentFromVault(
    disclose(run.proposal),
    disclose(run.runVault),
    disclose(kernel.self().bytes),
    disclose(run.root),
    disclose(run.payees),
    disclose(run.opensAt),
    disclose(run.closesAt),
    disclose(run.required),
    disclose(run.salt),
    disclose(unshieldedPayoutDetails(recipient, token, amount, blinding)),
    disclose(run.nonce),
    disclose(amount),
    disclose(token),
    disclose(run.path));
  mintReceipt(paymentReceiptTag(), paymentReceiptKey(), acct);

  // A refusal in words. The ledger refuses an overspend whether or not this is here.
  assert(unshieldedBalanceGte(disclose(token), disclose(amount)),
    "this vault does not hold enough of that token to make this payment");

  // To a user address nobody can validate, which is why it is inside the approved leaf.
  sendUnshielded(disclose(token), disclose(amount),
    right<ContractAddress, UserAddress>(UserAddress { bytes: disclose(recipient) }));

  payments.increment(1);
}

// Splits one held note into two, both kept, under an approved run. The piece's amount is
// recorded masked by the secret, so the company can name both pieces with every device gone.
export circuit splitNote(run: Run, token: Bytes<32>, amount: Uint<128>): [] {
  const s = currentSecret();
  const coin = noteToSpend(token, amount);
  assert(coin.color == token, "that is not a note of the token being split");
  assert(!(amount == 0), "a split has to cut a piece of something");
  // Strictly smaller than the note, so a split always leaves a remainder.
  assert(amount < coin.value,
    "a split has to leave something behind; that note is not bigger than the piece asked for");

  const self = kernel.self().bytes;
  const unqualified = ShieldedCoinInfo { nonce: coin.nonce, color: coin.color, value: coin.value };
  const spent = disclose(noteNullifierOf(self, unqualified));
  mintReceipt(changeReceiptTag(), changeReceiptKey(), askForChange(run, splitDetails(self, spent, token, amount)));
  spendHeldAs(coin, spent);
  // Keyed by the nullifier. The ledger accepts a nullifier once and never makes the same coin
  // twice, so the note is gone from the pool before any second split of it, and no split
  // overwrites another.
  splitJournal.insert(spent, disclose(maskedAmountOf(amount, splitMaskOf(s, spent))));

  keepCoin(ShieldedCoinInfo {
    nonce: disclose(freshNonceOf(splitNonceTag(), s, spent)), color: disclose(coin.color), value: disclose(amount)
  });
  keepCoin(ShieldedCoinInfo {
    nonce: disclose(freshNonceOf(restNonceTag(), s, spent)), color: disclose(coin.color),
    value: (disclose(coin.value) - disclose(amount)) as Uint<128>
  });
}

// Sets the vault's nonce secret under an approved run, replacing exactly the one named. The
// run approves the root of a tree holding every signer's sealed copy, and how many copies it
// holds; `edge` shows no copy sits past that count, and `writeSecretCopy` then writes each copy
// on its own. The caller holds the new secret and the last secret that took money, which is
// kept sealed under the new one, so a signer given only the newest secret opens every earlier
// one that matters. A secret whose copies never all reached the chain took no money, so it is
// replaced without being held, and the one it carried is carried on.
export circuit setNonceSecret(
  run: Run,
  previous: Bytes<32>,
  commitment: Bytes<32>,
  copies: Bytes<32>,
  count: Uint<64>,
  edge: Vector<10, CopyStep>,
  secret: Bytes<32>,
  earlier: Bytes<32>,
): [] {
  const next = disclose(commitment);
  const before = disclose(previous);
  assert(!(next == default<Bytes<32>>), "a secret's commitment of zero would leave the vault with no secret");
  assert(!(next == before), "that is the secret this vault already has");
  assert(nonceCommitment == before, "that run replaces a secret this vault no longer holds");
  assert(!(disclose(count) == 0), "a secret with no sealed copy can be opened by nobody");
  assert(!(mostCopies() < disclose(count)), "the tree of copies holds at most 1024, one for each signer the account can seat");
  assert(disclose(emptyFrom(copies, count, edge)),
    "that tree of copies holds a copy past its count, or does not show where its copies end. Make the secret run again from the copies, so its tree, count and edge agree");
  const self = kernel.self();
  assert(disclose(secretCommitmentOf(self.bytes, secret) == next),
    "this device does not hold the secret that run sets, so it cannot set it. Send it from a device that has opened the company's record holding that secret");
  assert(disclose(isNonceSecretShape(secret)),
    "a vault's secret ends in a zero byte, so a later secret can carry it, and this one does not. Make a new secret and have the signers approve a new secret run for it");
  const rootKey = disclose(copiesRootKeyOf(next));
  assert(!secretCopies.member(rootKey), "that secret was this vault's before, and a secret is never set twice");
  const acct = askForChange(run, secretRunDetails(self.bytes, before, next, disclose(copies), disclose(count)));
  // Worked out here, in the run every vault starts with, and kept for every later receipt.
  secretCopies.insert(paymentReceiptKey(), tokenType(paymentReceiptTag(), self));
  secretCopies.insert(changeReceiptKey(), mintUnshieldedToken(changeReceiptTag(), 1, left<ContractAddress, UserAddress>(acct)));
  // A commitment never repeats, so this root is written once. No money moves until every copy is.
  secretCopies.insert(rootKey, disclose(copies));
  secretCopies.insert(disclose(copiesCountKeyOf(next)), upgradeFromTransient(disclose(count) as Field));
  secretCopies.insert(disclose(copiesLeftKeyOf(next)), upgradeFromTransient(disclose(count) as Field));
  // The mark stays on the last secret that opened, and this one is not it, so no money moves
  // until every copy of this one is written.
  if (!secretCopies.member(copiesWrittenKey())) {
    secretCopies.insert(copiesWrittenKey(), default<Bytes<32>>);
  }
  // The secret this one carries: the last one the vault took money under. That is the one it
  // replaces if that one opened, or else the one before it that did; no coin is made under a
  // secret that never opened, so passing over it loses nothing.
  const carried = secretCopies.lookup(copiesWrittenKey());
  // Kept sealed under this one, so whoever opens this one opens it too. Proved here against its
  // commitment, so no caller can leave a later signer a key that opens nothing.
  if (!(carried == default<Bytes<32>>)) {
    assert(disclose(secretCommitmentOf(self.bytes, earlier) == carried),
      "this run does not carry the last secret this vault took money under, so it cannot replace it. Build it on a device that holds that secret and passes it as the earlier one");
    secretCopies.insert(disclose(earlierSecretKeyOf(next)), disclose(sealedEarlierOf(earlier, secret)));
  }
  nonceCommitment = next;
}

// Writes one sealed copy of a secret, checked against the root its secret run approved. Anyone
// may: only a copy under that root can be written, each place in the tree only once, and a copy
// that cannot be written holds up no other.
export circuit writeSecretCopy(
  commitment: Bytes<32>,
  reader: Bytes<32>,
  parts: Vector<4, Bytes<32>>,
  path: Vector<10, CopyStep>,
): [] {
  const rootKey = disclose(copiesRootKeyOf(commitment));
  assert(secretCopies.member(rootKey), "there is no approved list of sealed copies for that secret");
  assert(secretCopies.lookup(rootKey) == copiesRootOf(copyLeafOf(commitment, reader, parts), path),
    "that sealed copy is not one the signers approved for that secret");
  // Every place past the count is empty and no copy's leaf is, so each copy written sits below
  // the count and once each: the count left never runs below zero.
  const leftKey = disclose(copiesLeftKeyOf(commitment));
  const remaining = degradeToTransient(secretCopies.lookup(leftKey));
  const place = disclose(copyIndexOf(path));
  const first = disclose(copyKeyOf(commitment, reader, place, 0));
  assert(!secretCopies.member(first), "that sealed copy is already written");
  secretCopies.insert(first, disclose(parts[0]));
  secretCopies.insert(disclose(copyKeyOf(commitment, reader, place, 1)), disclose(parts[1]));
  secretCopies.insert(disclose(copyKeyOf(commitment, reader, place, 2)), disclose(parts[2]));
  secretCopies.insert(disclose(copyKeyOf(commitment, reader, place, 3)), disclose(parts[3]));
  secretCopies.insert(leftKey, upgradeFromTransient(remaining - 1));
  // The last copy of the current secret opens the vault to money again.
  if (remaining == (1 as Field) && disclose(commitment) == nonceCommitment) {
    secretCopies.insert(copiesWrittenKey(), disclose(commitment));
  }
}

// Drops a public token from the set once the chain says this vault holds none of it.
export circuit forgetUnshielded(token: Bytes<32>): [] {
  assert(unshieldedBalanceLte(disclose(token), 0),
    "this vault still holds some of that token");
  unshieldedTokens.remove(disclose(token));
}

// Refuses while this vault holds notes or public money, then asks the account to retire it.
export circuit retire(proposal: Bytes<32>, salt: Bytes<32>): [] {
  assert(notes.isEmpty(),
    "this vault still holds notes, and retiring it would strand them");

  assert(unshieldedTokens.isEmpty(),
    "this vault still holds public money, and retiring it would strand that too");

  account.retireVault(
    disclose(proposal),
    disclose(kernel.self().bytes),
    disclose(salt));
}
