pragma language_version 0.26.0;
import CompactStandardLibrary;

/*
 * THE VAULT. It holds a company's money and decides nothing.
 *
 * It holds two kinds side by side: private notes, recorded here only as
 * commitments in `notes`, and public money, whose balance the chain itself
 * keeps. Every payment out first asks the company's account contract, naming
 * this vault, and is made only if the account approves it and records it as
 * paid in the same transaction, so nothing is paid without that record.
 *
 * It refuses a note it does not hold, a note of the wrong token or too small,
 * a public payment it cannot cover, a public deposit of nothing, and, in its
 * own `retire`, retirement while it still holds either kind of money.
 * Deposits and housekeeping need no approval, and none of them sends money out.
 *
 * Why each piece is shaped this way: docs/design/the-vault-contract.md
 */

// The account this vault answers to, and the only two calls a vault may make to it.
contract Acct {
  // Approves and records one payee's payment, or fails the whole transaction.
  circuit recordPayment(
    proposal: Bytes<32>,
    vault: Bytes<32>,
    root: Bytes<32>,
    payees: Uint<64>,
    opensAt: Uint<64>,
    closesAt: Uint<64>,
    salt: Bytes<32>,
    details: Bytes<32>,
    nonce: Bytes<32>,
    path: MerkleTreePath<16, Bytes<32>>,
  ): Bytes<32>;

  // Takes this vault off the account's register, under an approved retire proposal.
  circuit retireVault(
    proposal: Bytes<32>,
    vault: Bytes<32>,
    salt: Bytes<32>,
  ): [];
}

// Written once, by the constructor. No circuit writes it.
export ledger account: Acct;

// The private notes this vault holds, as commitments. The notes stay on the owner's device.
export ledger notes: Set<Bytes<32>>;

// Public tokens this vault may still hold: added on deposit, dropped by `forgetUnshielded`.
export ledger unshieldedTokens: Set<Bytes<32>>;

// How many payments this vault has made. Public.
export ledger payments: Counter;

// Reserved for a spending cap per period. Declared only: no circuit reads or writes it.
export ledger spendingCaps: Map<Bytes<32>, Bytes<32>>;

// The note to spend, chosen on the owner's device. Untrusted: every reader checks it.
witness noteToSpend(token: Bytes<32>, amount: Uint<128>): QualifiedShieldedCoinInfo;

// Pins the account.
constructor(a: Acct) {
  account = disclose(a);
}

// A private payment's recipient, token and amount, committed under a blinding.
export circuit payoutDetails(
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [recipient, token, amount as Field as Bytes<32>], blinding);
}

// The same for public money, tagged so an approval for one kind cannot settle the other.
export circuit unshieldedPayoutDetails(
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<4, Bytes<32>>>(
    [pad(32, "midnight-vault:unshielded:"),
     recipient, token, amount as Field as Bytes<32>], blinding);
}

// What the pool records for a note: its nonce, token and amount, not its tree position.
export circuit heldCommitmentOf(coin: ShieldedCoinInfo, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<ShieldedCoinInfo>(coin, blinding);
}

// Every note's blinding, derived from the coin and this vault's address, so nobody chooses it.
export circuit noteBlindingOf(vault: Bytes<32>, coin: ShieldedCoinInfo): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "midnight-vault:note-blinding:"),
    vault,
    coin.nonce,
    coin.color,
    coin.value as Field as Bytes<32>,
  ]);
}

// Accepts a private note from anyone, with no approval, and adds it to the pool.
export circuit deposit(coin: ShieldedCoinInfo): [] {
  receiveShielded(disclose(coin));
  notes.insert(disclose(heldCommitmentOf(coin, noteBlindingOf(kernel.self().bytes, coin))));
}

// Accepts public money from anyone, with no approval. Refuses a deposit of nothing.
export circuit depositUnshielded(token: Bytes<32>, amount: Uint<128>): [] {
  assert(!(amount == 0), "a deposit of nothing is not a deposit");
  receiveUnshielded(disclose(token), disclose(amount));
  unshieldedTokens.insert(disclose(token));
}

// Pays one payee of an approved run in private money. Payee, token and amount stay private.
export circuit payout(
  proposal: Bytes<32>,
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  salt: Bytes<32>,
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
  nonce: Bytes<32>,
  path: MerkleTreePath<16, Bytes<32>>,
): [] {
  // The account refuses unless the run is approved for this vault and this payee is unpaid.
  const details = payoutDetails(recipient, token, amount, blinding);
  const authorised = account.recordPayment(
    disclose(proposal),
    disclose(kernel.self().bytes),
    disclose(root),
    disclose(payees),
    disclose(opensAt),
    disclose(closesAt),
    disclose(salt),
    disclose(details),
    disclose(nonce),
    disclose(path));

  // The note offered must be of this token, big enough, and in the pool.
  const coin = noteToSpend(token, amount);
  assert(coin.color == token, "that is not a note of the token being paid");
  assert(!(coin.value < amount), "that note does not hold enough to make this payment");

  const unqualified = ShieldedCoinInfo {
    nonce: coin.nonce, color: coin.color, value: coin.value
  };
  const spent = disclose(heldCommitmentOf(
    unqualified, noteBlindingOf(kernel.self().bytes, unqualified)));
  assert(notes.member(spent), "that note is not in this vault's pool");
  // Removed before anything is sent, so one note cannot fund two payments.
  notes.remove(spent);

  const result = sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey { bytes: disclose(recipient) }),
    disclose(amount));

  // Any change goes back into the pool as a new note.
  if (disclose(result.change.is_some)) {
    notes.insert(disclose(heldCommitmentOf(
      result.change.value,
      noteBlindingOf(kernel.self().bytes, result.change.value))));
  }
  payments.increment(1);
}

// Pays one payee of an approved run in public money. The amount and recipient are public.
export circuit payoutUnshielded(
  proposal: Bytes<32>,
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  salt: Bytes<32>,
  recipient: Bytes<32>,
  token: Bytes<32>,
  amount: Uint<128>,
  blinding: Bytes<32>,
  nonce: Bytes<32>,
  path: MerkleTreePath<16, Bytes<32>>,
): [] {
  // Its own details, so a leaf approved for private money cannot be settled here.
  const details = unshieldedPayoutDetails(recipient, token, amount, blinding);
  const authorised = account.recordPayment(
    disclose(proposal),
    disclose(kernel.self().bytes),
    disclose(root),
    disclose(payees),
    disclose(opensAt),
    disclose(closesAt),
    disclose(salt),
    disclose(details),
    disclose(nonce),
    disclose(path));

  // A refusal in words. The ledger refuses an overspend whether or not this is here.
  assert(unshieldedBalanceGte(disclose(token), disclose(amount)),
    "this vault does not hold enough of that token to make this payment");

  // To a user address nobody can validate, which is why it is inside the approved leaf.
  sendUnshielded(disclose(token), disclose(amount),
    right<ContractAddress, UserAddress>(UserAddress { bytes: disclose(recipient) }));

  payments.increment(1);
}

// Splits one held note into two, both kept. No approval: it cannot pay anything out.
export circuit splitNote(token: Bytes<32>, amount: Uint<128>): [] {
  const coin = noteToSpend(token, amount);
  assert(coin.color == token, "that is not a note of the token being split");

  // Strictly smaller than the note, so a split always leaves a remainder.
  assert(amount < coin.value,
    "a split has to leave something behind; that note is not bigger than the piece asked for");

  const self = disclose(kernel.self().bytes);

  const unqualified = ShieldedCoinInfo {
    nonce: coin.nonce, color: coin.color, value: coin.value
  };
  const spent = disclose(heldCommitmentOf(
    unqualified, noteBlindingOf(self, unqualified)));
  assert(notes.member(spent), "that note is not one this vault holds");
  notes.remove(spent);

  const result = sendShielded(
    disclose(coin),
    // To this vault itself, never to an argument.
    right<ZswapCoinPublicKey, ContractAddress>(kernel.self()),
    disclose(amount));

  notes.insert(disclose(heldCommitmentOf(
    result.sent, noteBlindingOf(self, result.sent))));

  // Cannot fail after the size check; asserted so the remainder is never dropped.
  assert(result.change.is_some, "a split produced no remainder, which the size check forbids");
  notes.insert(disclose(heldCommitmentOf(
    result.change.value, noteBlindingOf(self, result.change.value))));
}

// Drops a public token from the set once the chain says this vault holds none of it.
export circuit forgetUnshielded(token: Bytes<32>): [] {
  assert(unshieldedBalanceLte(disclose(token), 0),
    "this vault still holds some of that token");
  unshieldedTokens.remove(disclose(token));
}

// Refuses while this vault holds notes or public money, then asks the account to retire it.
export circuit retire(proposal: Bytes<32>, salt: Bytes<32>): [] {
  assert(notes.isEmpty(),
    "this vault still holds notes, and retiring it would strand them");

  assert(unshieldedTokens.isEmpty(),
    "this vault still holds public money, and retiring it would strand that too");

  account.retireVault(
    disclose(proposal),
    disclose(kernel.self().bytes),
    disclose(salt));
}
