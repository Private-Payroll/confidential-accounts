pragma language_version 0.26.0;

import CompactStandardLibrary;

/*
 * THE ACCOUNT. An M-of-N rulebook that decides what a company's vaults may pay.
 *
 * Signers are blinded leaves in a Merkle tree, so the chain holds a root and
 * never a list of who they are. A signer proves membership without saying
 * which one they are, and an approval is a nullifier: it shows a distinct
 * signer agreed without naming them. The threshold, the approvals so far and
 * the existence of each proposal are public on purpose.
 *
 * It holds no money and sends none. A payment is recorded only with a receipt:
 * the paying vault mints one unit of its own token to this account in the same
 * transaction, and `recordPaymentFromVault` receives it, accepting only a vault
 * this account has ever adopted. A call with no real payment behind it leaves
 * that token unbalanced, and the network refuses the whole transaction. The
 * receipts accumulate here as tokens with no value; nothing can spend them.
 *
 * For each payment the account records two values: one for the payee's leaf,
 * so no leaf is paid twice, and one for the person, month, kind and occurrence
 * the payee's nonce was derived from, so nobody is paid twice for one month at
 * another amount, address or form. A real second payment is a later occurrence.
 *
 * The key those nonces are derived from is kept in `signerRoles`, sealed to
 * each signer by that signer, beside one commitment to it written under an
 * approved proposal.
 *
 * It refuses a signer-only call from anyone else, a second approval from one
 * signer, a proposal short of its threshold, a payment without a vault's
 * receipt, from a contract it never adopted, outside its run's window or not in
 * its run, a payee leaf already paid, a person already paid for that month, kind
 * and occurrence, and any change that leaves fewer signers than the account
 * threshold.
 *
 * A run's root is a sum tree: each node commits both children and both their
 * sums, and the root commits the run's total and the one asset it pays in, so
 * what a run can pay is at most the total its signers approved. A run names the
 * approvals its total needs, inside its id. A company may put a vault under a
 * spending policy per asset: four bands, each a ceiling on a run's total and the
 * approvals it needs, and a limit per period. `clearRun` charges an approved run
 * to its period once, inside its window; a vault under a policy pays only its
 * own runs once charged, and refuses an asset it has no policy for. A vault with
 * no policy is paid at its approvals, with no limit.
 *
 * A signer being removed can do nothing against the company. A proposal needs
 * the higher of the threshold when it was raised and the threshold now, so a
 * fall never releases approvals already given. A governance proposal is
 * withdrawn only by the signer who raised it. A removal voids every governance
 * proposal raised before it, and a run raised before it needs one approval
 * more for every removal since. Removing a signer and setting the threshold is
 * one proposal.
 *
 * Why each piece is shaped this way: docs/design/the-account-contract.md
 */

// The signer set: one slot per signer, each holding a blinded leaf.
export ledger signers: MerkleTree<10, Bytes<32>>;

// Every approval ever given, as nullifiers. Never cleared.
export ledger approvals: Set<Bytes<32>>;

// The open proposals, by id, each with its change commitment.
export ledger openProposals: Map<Bytes<32>, Bytes<32>>;

// How many approvals each open proposal has. Public.
export ledger approvalCounts: Map<Bytes<32>, Uint<64>>;

// Two markers per payment, in any run: its payee leaf, and the person and month it pays.
// Nothing removes from it.
export ledger movements: Set<Bytes<32>>;

// M in M of N, for the account and for every vault without its own. Public.
export ledger threshold: Uint<64>;

// Per-vault thresholds. A vault with no row uses the account's.
export ledger thresholds: Map<Bytes<32>, Uint<64>>;

// The vaults this account has adopted. With `retiredAt`, the only contracts a payment is accepted from.
export ledger vaults: Set<Bytes<32>>;

// When a run may be paid: from `opensAt`, and before `closesAt`.
struct Window {
  opensAt: Uint<64>;
  closesAt: Uint<64>;
}

// Each run's window. A governance proposal has no row, and `cancel` relies on that.
export ledger runWindow: Map<Bytes<32>, Window>;

// Every leaf currently seated. Its size is the number of signers.
export ledger signerLeaves: Set<Bytes<32>>;

// Every vault this account has ever retired. The value is a marker, not a date.
export ledger retiredAt: Map<Bytes<32>, Uint<64>>;

// A hold placed on a run, and what releases it. Written empty; no circuit reads it yet.
struct RunHold {
  placedBy: Bytes<32>;
  releaseNeeded: Uint<64>;
  releaseApprovals: Uint<64>;
}

// What a proposal carries from the moment it is raised until it closes.
struct Hold {
  // The approvals it needed when it was raised.
  needed: Uint<64>;
  // A hash of the proposer's withdraw secret: only the proposer can withdraw it.
  withdrawKey: Bytes<32>;
  // How many signers the account had removed when it was raised.
  removals: Uint<64>;
  runHold: RunHold;
}

// Each open proposal's hold, by id, and the account's removal count under its own key.
export ledger proposalHolds: Map<Bytes<32>, Hold>;

// Reserved for a replacement account's address. No circuit writes it.
export ledger successor: Bytes<32>;

// One shared map of 32-byte entries. Every key is derived inside a circuit under its own tag.
export ledger signerRoles: Map<Bytes<32>, Bytes<32>>;

// The signer's secret key, from their own device. Never disclosed.
witness localSecretKey(): Bytes<32>;

// A path in the signer tree: to the caller's leaf, a departing leaf, or a vacated slot.
witness signerPath(leaf: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// The blinding that hides this signer's leaf. Held on their device only.
witness signerBlinding(): Bytes<32>;

// Which vaults this signer may act on. Part of the leaf; nothing checks it yet.
witness signerScope(): Bytes<32>;

// The asset a proposal concerns. Only ever used inside a blinded commitment.
witness assetId(): Bytes<32>;

// The account's blinding for asset keys, the same for every signer.
witness assetBlinding(): Bytes<32>;

// The fresh salt that blinds a proposal's id.
witness proposalSalt(): Bytes<32>;

// The amount recorded in a proposal's change commitment. Private.
witness changeAmount(): Uint<128>;

// A digest over the entries a proposal's change appends.
witness changeBatchDigest(): Bytes<32>;

// The key a new proposal is withdrawn with: the hash of the proposer's withdraw secret for it.
witness withdrawKey(proposal: Bytes<32>): Bytes<32>;

// The proposer's withdraw secret for one proposal. Held on their device only.
witness withdrawSecret(proposal: Bytes<32>): Bytes<32>;

// One band of a spending policy: a run whose total is at most `ceiling` needs `approvals`.
struct Band {
  ceiling: Uint<128>;
  approvals: Uint<64>;
}

// A vault's spending policy for one token: four bands, a limit per period, and the periods.
// Period `n` runs from `periodStart + n * periodLength` for `periodLength` seconds.
struct PolicyTerms {
  bands: Vector<4, Band>;
  periodLimit: Uint<128>;
  periodStart: Uint<64>;
  periodLength: Uint<64>;
}

// A policy as the signers hold it: its terms and the blinding its commitment is made under.
struct Policy {
  terms: PolicyTerms;
  blinding: Bytes<32>;
}

// The opening of the policy a run is charged against. Held by the signers only.
witness policyOpening(): Policy;

// What the vault has already been charged in the run's period, which the stored total opens to.
witness periodSpent(): Uint<128>;

// A signer's public identity: a domain-tagged hash of their secret key.
export circuit signerPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:signer:pk:"), sk
  ]);
}

// A signer's leaf: their key and scope, domain-tagged and committed under their blinding.
export circuit signerLeaf(pk: Bytes<32>, blinding: Bytes<32>, scope: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "midnight-accounts:signer-leaf:"), pk, scope], blinding);
}

// An asset's key for this account: the asset committed under the account's blinding.
export circuit assetKeyOf(asset: Bytes<32>, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(asset, blinding);
}

// A proposal's change (asset, amount, batch), committed under its salt. Stored, never opened.
export circuit changeCommitmentOf(
  assetKey: Bytes<32>,
  amount: Uint<128>,
  batch: Bytes<32>,
  salt: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<4, Bytes<32>>>(
    [pad(32, "midnight-accounts:change:"),
     assetKey, amount as Field as Bytes<32>, batch], salt
  );
}

// A proposal's id: its payload and its vault, committed under a fresh salt.
export circuit proposalIdOf(
  payloadHash: Bytes<32>,
  vault: Bytes<32>,
  salt: Bytes<32>,
): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "midnight-accounts:proposal-id:"), payloadHash, vault], salt);
}

// One signer's approval of one proposal here. Unlinkable across proposals and accounts.
circuit approvalNullifier(sk: Bytes<32>, proposal: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "midnight-accounts:approval:"), kernel.self().bytes, proposal, sk
  ]);
}

// What signers approve to seat a leaf.
export circuit signerAddPayload(newSignerLeaf: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:add-signer:"), newSignerLeaf
  ]);
}

// What signers approve to unseat a leaf.
export circuit removeSignerPayload(removedLeaf: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:remove-signer:"), removedLeaf
  ]);
}

// What signers approve to change the account threshold.
export circuit setThresholdPayload(newThreshold: Uint<64>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:set-threshold:"), newThreshold as Field as Bytes<32>
  ]);
}

// The scope every signer is seated with today: every vault.
export circuit allVaults(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:scope:all"));
}

// The vault a governance proposal names: a hash no vault address can equal.
export circuit noVault(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:vault:none"));
}

// The record that a payee was paid. Keyed on the leaf alone, so once in any run.
export circuit paidMovementOf(leaf: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:paid:"), leaf]);
}

// What signers approve for a run: its root, which commits its total and its token, its payee
// count, its window, and the approvals its total needs.
export circuit runPayload(
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  required: Uint<64>,
): Bytes<32> {
  return persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "midnight-accounts:run:"),
    root,
    payees as Field as Bytes<32>,
    opensAt as Field as Bytes<32>,
    closesAt as Field as Bytes<32>,
    required as Field as Bytes<32>,
  ]);
}

// One payee's leaf: the vault's blinded details and a per-payee secret nonce.
export circuit payoutLeaf(details: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:payee:"), details, nonce]);
}

// What signers approve to set one vault's threshold.
export circuit setVaultThresholdPayload(vault: Bytes<32>, newThreshold: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    // Shortened to fit 32 bytes.
    pad(32, "midnight-accounts:vault-thresh:"),
    vault,
    newThreshold as Field as Bytes<32>,
  ]);
}

// What a removal writes into a slot, so the slot can be proved empty and reused.
export circuit vacantSlot(): Bytes<32> {
  return pad(32, "midnight-accounts:vacant-slot:");
}

// What signers approve to adopt a vault.
export circuit adoptVaultPayload(vault: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:adopt-vault:"), vault
  ]);
}

// What signers approve to retire a vault.
export circuit retireVaultPayload(vault: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:retire-vault:"), vault
  ]);
}

// What signers approve to remove a signer and set the threshold, in one proposal.
export circuit removeAndSetThresholdPayload(removedLeaf: Bytes<32>, newThreshold: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:remove-thresh:"),
    removedLeaf,
    newThreshold as Field as Bytes<32>,
  ]);
}

// The vault a company-wide decision names: a hash no vault address can equal.
export circuit companyWide(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:vault:company"));
}

// A proposer's withdraw secret: their secret key, the account and the proposal, domain-tagged.
export circuit withdrawSecretOf(sk: Bytes<32>, account: Bytes<32>, proposal: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "midnight-accounts:withdraw-sec:"), sk, account, proposal
  ]);
}

// The key stored for a proposal: its withdraw secret, hashed again under its own tag.
export circuit withdrawKeyOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:withdraw:"), secret
  ]);
}

// One level of a payee's path in a run's sum tree: the sibling node, its sum, and which side
// the path is on.
struct SumStep {
  sibling: Field;
  siblingSum: Uint<128>;
  goesLeft: Boolean;
}

// A node of a run's sum tree, and the sum of the amounts under it.
struct SumNode {
  node: Field;
  sum: Uint<128>;
}

struct SumLeafPreimage {
  tag: Field;
  leaf: Bytes<32>;
  amount: Uint<128>;
}

struct SumInnerPreimage {
  tag: Field;
  left: Field;
  leftSum: Uint<128>;
  right: Field;
  rightSum: Uint<128>;
}

struct SumRootPreimage {
  tag: Field;
  top: Field;
  total: Uint<128>;
  asset: Bytes<32>;
}

// A payee's node in a run's sum tree: their leaf and the amount it pays.
export circuit sumLeafNode(leaf: Bytes<32>, amount: Uint<128>): Field {
  return transientHash<SumLeafPreimage>(SumLeafPreimage { tag: 5 as Field, leaf: leaf, amount: amount });
}

// An inner node: both children and both children's sums, so a path's sibling sum is fixed by
// the node above it and the amounts a root can pay add up to its total.
export circuit sumInnerNode(left: Field, leftSum: Uint<128>, right: Field, rightSum: Uint<128>): Field {
  return transientHash<SumInnerPreimage>(
    SumInnerPreimage { tag: 7 as Field, left: left, leftSum: leftSum, right: right, rightSum: rightSum });
}

// A run's root: the top node, the total it pays and the one token it pays in.
export circuit sumRootOf(top: Field, total: Uint<128>, asset: Bytes<32>): Bytes<32> {
  return transientHash<SumRootPreimage>(
    SumRootPreimage { tag: 9 as Field, top: top, total: total, asset: asset }) as Bytes<32>;
}

// One step up a path. The sum is cast back to 128 bits, which refuses a sum that overflows.
circuit sumStepUp(below: SumNode, step: SumStep): SumNode {
  const left = step.goesLeft ? below.node : step.sibling;
  const leftSum = step.goesLeft ? below.sum : step.siblingSum;
  const right = step.goesLeft ? step.sibling : below.node;
  const rightSum = step.goesLeft ? step.siblingSum : below.sum;
  return SumNode {
    node: sumInnerNode(left, leftSum, right, rightSum),
    sum: (below.sum + step.siblingSum) as Uint<128>,
  };
}

// The root a payee's path reaches, from their leaf, the amount and the token.
export circuit sumPathRoot(
  leaf: Bytes<32>,
  amount: Uint<128>,
  path: Vector<16, SumStep>,
  asset: Bytes<32>,
): Bytes<32> {
  const top = fold(sumStepUp, SumNode { node: sumLeafNode(leaf, amount), sum: amount }, path);
  return sumRootOf(top.node, top.sum, asset);
}

// Where a vault's policy for one token sits in `signerRoles`: the vault and the token's
// blinded key, so the key does not name the token.
export circuit policyKeyOf(vault: Bytes<32>, assetKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:roles:policy:"), vault, assetKey
  ]);
}

// Where the marker that a vault is under a spending policy sits in `signerRoles`.
export circuit policyOnKeyOf(vault: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:roles:pol-on:"), vault
  ]);
}

// The marker's value.
export circuit policyOnMark(): Bytes<32> {
  return pad(32, "midnight-accounts:policy-on");
}

// A policy's commitment, made under its own blinding. Persistent, so it opens after an upgrade.
export circuit policyCommitmentOf(policy: Policy): Bytes<32> {
  return persistentCommit<PolicyTerms>(policy.terms, policy.blinding);
}

// Where one period's running total sits: the policy's key, its commitment and the period, so
// a new policy starts every period afresh.
export circuit periodKeyOf(policyKey: Bytes<32>, commitment: Bytes<32>, period: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "midnight-accounts:roles:period:"), policyKey, commitment, period as Field as Bytes<32>
  ]);
}

// The blinding of one period's running total, from the policy's blinding and the period, so
// any signer holding the policy can open it.
export circuit periodBlindingOf(blinding: Bytes<32>, period: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:period-blind:"), blinding, period as Field as Bytes<32>
  ]);
}

// One period's running total, committed under that period's blinding.
export circuit periodTotalOf(total: Uint<128>, blinding: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:period-total:"), total as Field as Bytes<32>
  ], blinding);
}

// Where the record that a run's root was charged in a period sits. A run raised again over
// the same tree in the same period is not charged a second time.
export circuit chargedKeyOf(periodKey: Bytes<32>, root: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:roles:charged:"), periodKey, root
  ]);
}

// The value written under a charged key.
export circuit chargedMark(): Bytes<32> {
  return pad(32, "midnight-accounts:charged");
}

// What a cleared run's change commitment is overwritten with. No commitment can equal it.
export circuit clearedMark(): Bytes<32> {
  return pad(32, "midnight-accounts:cleared");
}

// The key in `thresholds` for the approvals a policy change needs. No vault address can equal it.
export circuit policyBarKey(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:vault:policy"));
}

// What signers approve to set one vault's policy for one token.
export circuit setPolicyPayload(vault: Bytes<32>, assetKey: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "midnight-accounts:set-policy:"), vault, assetKey, commitment
  ]);
}

// The approvals a run's total needs under a policy: the first band whose ceiling it fits.
// Refuses a total above every band.
export circuit bandApprovals(bands: Vector<4, Band>, total: Uint<128>): Uint<64> {
  const fits0 = !(bands[0].ceiling < total);
  const fits1 = !(bands[1].ceiling < total);
  const fits2 = !(bands[2].ceiling < total);
  const fits3 = !(bands[3].ceiling < total);
  assert(fits0 || fits1 || fits2 || fits3,
    "that run's total is above every band of this vault's policy, so no number of approvals can pay it");
  return fits0 ? bands[0].approvals
       : fits1 ? bands[1].approvals
       : fits2 ? bands[2].approvals
       : bands[3].approvals;
}

// The record that a person was paid for one month, kind and occurrence, which the nonce
// was derived from. Keyed on the nonce alone, so it holds whatever the amount, address or form.
export circuit paidOnceOf(nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:paid-once:"), nonce]);
}

// Where the account's commitment to its pay-record key sits in `signerRoles`.
export circuit payKeyCommitmentKey(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:roles:pay-key"));
}

// Where one of the four parts of a signer's sealed copy of the pay-record key sits in
// `signerRoles`: derived from their secret key and the account, so only they can write it.
export circuit payKeyWrapKeyOf(account: Bytes<32>, sk: Bytes<32>, part: Uint<8>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "midnight-accounts:roles:wrap:"), account, sk, part as Field as Bytes<32>
  ]);
}

// What every device checks the pay-record key it unsealed against.
export circuit payKeyCommitmentOf(key: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:paykey-commit:"), key
  ]);
}

// What signers approve to commit the account to its pay-record key.
export circuit payKeyPayload(commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight-accounts:pay-key:"), commitment
  ]);
}

// Where the company's label sits in `signerRoles`.
export circuit companyLabelKey(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:roles:label"));
}

// Reserved: where a later anchor entry will sit in `signerRoles`. No circuit writes it yet.
export circuit anchorKey(): Bytes<32> {
  return persistentHash<Bytes<32>>(pad(32, "midnight-accounts:roles:anchor"));
}

// The tag a vault mints its payment receipt under: the token `tokenType(tag, vault)`,
// which only that vault can mint.
export circuit paymentReceiptTag(): Bytes<32> {
  return pad(32, "midnight-accounts:receipt:pay");
}

// A company-wide run's leaf details, bound to the vault paying it, so no vault can
// spend another vault's leaf.
export circuit companyWideDetailsOf(details: Bytes<32>, vault: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "midnight-accounts:company-leaf:"), details, vault
  ]);
}

// Where the account's removal count sits in `proposalHolds`. No proposal id can equal it.
export circuit removalCountKey(): Bytes<32> {
  return pad(32, "midnight-accounts:removal-count");
}

// The slot a path leads to, read from its left-right flags.
export circuit slotOf(path: MerkleTreePath<10, Bytes<32>>): Uint<64> {
  return (
    (path.path[0].goes_left ? 0 : 1) +
    (path.path[1].goes_left ? 0 : 2) +
    (path.path[2].goes_left ? 0 : 4) +
    (path.path[3].goes_left ? 0 : 8) +
    (path.path[4].goes_left ? 0 : 16) +
    (path.path[5].goes_left ? 0 : 32) +
    (path.path[6].goes_left ? 0 : 64) +
    (path.path[7].goes_left ? 0 : 128) +
    (path.path[8].goes_left ? 0 : 256) +
    (path.path[9].goes_left ? 0 : 512)
  ) as Uint<64>;
}

// Proves the caller is a signer without saying which. Refuses anyone else.
circuit requireSigner(): Bytes<32> {
  const sk = localSecretKey();
  const leaf = signerLeaf(signerPublicKey(sk), signerBlinding(), signerScope());
  const path = signerPath(leaf);

  // The path must lead to the caller's own leaf.
  assert(path.leaf == leaf, "that membership path is not yours");

  const root = merkleTreePathRoot<10, Bytes<32>>(path);
  assert(signers.checkRoot(disclose(root)), "not a signer on this account");
  return sk;
}

// Closes one proposal: its entry, its count, its hold and its window, if it has one.
circuit closeProposal(proposal: Bytes<32>): [] {
  openProposals.remove(proposal);
  approvalCounts.remove(proposal);
  proposalHolds.remove(proposal);
  runWindow.remove(proposal);
}

// How many signers this account has removed. Written by the constructor, so always present.
circuit removalsSoFar(): Uint<64> {
  return proposalHolds.lookup(removalCountKey()).removals;
}

// Adds one to the removal count. Every circuit that unseats a leaf calls it.
circuit countRemoval(): [] {
  proposalHolds.insert(removalCountKey(), Hold {
    needed: 0,
    withdrawKey: default<Bytes<32>>,
    removals: (removalsSoFar() + 1) as Uint<64>,
    runHold: default<RunHold>,
  });
}

// The larger of two bars.
circuit higher(a: Uint<64>, b: Uint<64>): Uint<64> {
  return a < b ? b : a;
}

// A proposal's hold. Refuses one raised without a hold: it can never be carried out.
circuit holdOf(proposal: Bytes<32>): Hold {
  assert(proposalHolds.member(proposal),
    "that proposal has no record of the approvals it needs, so it can never be carried out");
  return proposalHolds.lookup(proposal);
}

// A vault's own threshold if it has one, otherwise the account's.
circuit thresholdFor(vault: Bytes<32>): Uint<64> {
  return thresholds.member(vault) ? thresholds.lookup(vault) : threshold;
}

// Refuses a run short of the highest of its bar when raised, the vault's today and the
// approvals its total needs, plus one for every signer removed since it was raised.
// Returns its change.
circuit requireApprovedForVault(proposal: Bytes<32>, vault: Bytes<32>, required: Uint<64>): Bytes<32> {
  assert(openProposals.member(proposal), "there is no open proposal with that id");
  const hold = holdOf(proposal);
  const bar = higher(higher(hold.needed, thresholdFor(vault)), required);
  // Each removed signer's approval may be among those given, so one more is needed for each.
  const needed = (bar + (removalsSoFar() - hold.removals)) as Uint<64>;
  assert(!(approvalCounts.lookup(proposal) < needed), "not enough approvals yet");
  return openProposals.lookup(proposal);
}

// Refuses a governance proposal raised before the latest removal, or short of the higher of
// its bar when raised and the account's today. Returns its change.
circuit requireApproved(proposal: Bytes<32>): Bytes<32> {
  assert(openProposals.member(proposal), "there is no open proposal with that id");
  const hold = holdOf(proposal);
  assert(hold.removals == removalsSoFar(), "a signer has been removed since this was raised; raise it again");
  assert(!(approvalCounts.lookup(proposal) < higher(hold.needed, threshold)), "not enough approvals yet");
  return openProposals.lookup(proposal);
}

// Proves a slot holds the vacancy marker, and returns which slot it is.
circuit takeVacatedSlot(): Uint<64> {
  const path = signerPath(vacantSlot());
  assert(path.leaf == vacantSlot(), "that slot has not been vacated");
  const root = merkleTreePathRoot<10, Bytes<32>>(path);
  assert(signers.checkRoot(disclose(root)), "that path is not from this tree");
  return slotOf(path);
}

// Seats one founding signer at a threshold of one, and writes the company's label.
constructor(foundingLeaf: Bytes<32>, companyLabel: Bytes<32>) {
  // Neither zero nor the vacancy marker may be seated.
  assert(foundingLeaf != default<Bytes<32>>, "that is not a usable signer leaf");
  assert(foundingLeaf != vacantSlot(), "that is not a usable signer leaf");
  assert(companyLabel != default<Bytes<32>>, "a company needs a label");
  const seatedLeaf = disclose(foundingLeaf);
  signers.insert(seatedLeaf);
  signerLeaves.insert(seatedLeaf);
  threshold = 1;
  // The label, under a key derived here and never taken from a caller.
  signerRoles.insert(companyLabelKey(), disclose(companyLabel));
  // No signer removed yet.
  proposalHolds.insert(removalCountKey(), Hold {
    needed: 0,
    withdrawKey: default<Bytes<32>>,
    removals: 0,
    runHold: default<RunHold>,
  });
}

// Seats a signer, or unseats one when `removing` is true. Needs a signer as caller.
export circuit amendSigner(
  leaf: Bytes<32>,
  proposal: Bytes<32>,
  intoVacatedSlot: Boolean,
  removing: Boolean,
): [] {
  requireSigner();

  if (disclose(removing)) {
  const removedLeaf = leaf;

  const id = disclose(proposal);
  requireApproved(id);
  assert(
    disclose(proposalIdOf(removeSignerPayload(removedLeaf), noVault(), proposalSalt()) == proposal),
    "that proposal is not for this removal"
  );

  // Only a seated leaf can be removed: never the vacancy marker, never a stranger.
  assert(signerLeaves.member(disclose(removedLeaf)), "that signer is not seated on this account");

  // The departing leaf must be in the tree; its path gives its slot.
  const path = signerPath(removedLeaf);
  assert(path.leaf == removedLeaf, "that path is not for the leaf being removed");
  assert(signers.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "that signer is not on this account");

  // Stamped vacant rather than cleared, so the slot can be reused.
  signers.insertIndex(vacantSlot(), disclose(slotOf(path)));
  signerLeaves.remove(disclose(removedLeaf));

  // Refuses a removal that leaves fewer signers than the threshold.
  assert(!(signerLeaves.size() < threshold),
    "that would leave fewer signers than the threshold, and the account could never approve again");

  countRemoval();
  closeProposal(id);
  } else {
  const newSignerLeaf = leaf;

  // Neither zero nor the vacancy marker may be seated.
  assert(newSignerLeaf != default<Bytes<32>>, "that is not a usable signer leaf");
  assert(newSignerLeaf != vacantSlot(), "that is not a usable signer leaf");

  // One leaf, one seat.
  assert(!signerLeaves.member(disclose(newSignerLeaf)), "that signer is already on this account");

  // Always true: signers never fall below the threshold, so every later seat needs a proposal.
  if (!(signerLeaves.size() < threshold)) {
    const id = disclose(proposal);
    requireApproved(id);
    assert(
      disclose(proposalIdOf(signerAddPayload(newSignerLeaf), noVault(), proposalSalt()) == proposal),
      "that proposal is not for this signer"
    );

    closeProposal(id);
  }

  // Into a vacated slot, or appended.
  if (disclose(intoVacatedSlot)) {
    signers.insertIndex(disclose(newSignerLeaf), disclose(takeVacatedSlot()));
  } else {
    signers.insert(disclose(newSignerLeaf));
  }
  signerLeaves.insert(disclose(newSignerLeaf));
  }
}

// Changes the threshold under an approved proposal. Refuses zero, or more than the signers.
export circuit setThreshold(newThreshold: Uint<64>, proposal: Bytes<32>): [] {
  requireSigner();

  const id = disclose(proposal);
  requireApproved(id);
  assert(
    disclose(proposalIdOf(setThresholdPayload(newThreshold), noVault(), proposalSalt()) == proposal),
    "that proposal is not for this threshold"
  );

  assert(disclose(newThreshold) > 0, "the threshold must be at least one");

  assert(!(signerLeaves.size() < disclose(newThreshold)),
    "the threshold cannot exceed the number of signers, or one signer could seat their own");

  threshold = disclose(newThreshold);

  closeProposal(disclose(proposal));
}

// Removes one signer and sets the threshold under one approved proposal.
export circuit removeSignerAndSetThreshold(
  removedLeaf: Bytes<32>,
  newThreshold: Uint<64>,
  proposal: Bytes<32>,
): [] {
  requireSigner();

  const id = disclose(proposal);
  requireApproved(id);
  assert(
    disclose(proposalIdOf(
      removeAndSetThresholdPayload(removedLeaf, newThreshold), noVault(), proposalSalt()) == proposal),
    "that proposal is not for this removal and threshold"
  );

  // Only a seated leaf can be removed: never the vacancy marker, never a stranger.
  assert(signerLeaves.member(disclose(removedLeaf)), "that signer is not seated on this account");

  // The departing leaf must be in the tree; its path gives its slot.
  const path = signerPath(removedLeaf);
  assert(path.leaf == removedLeaf, "that path is not for the leaf being removed");
  assert(signers.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "that signer is not on this account");

  // Stamped vacant rather than cleared, so the slot can be reused.
  signers.insertIndex(vacantSlot(), disclose(slotOf(path)));
  signerLeaves.remove(disclose(removedLeaf));

  assert(disclose(newThreshold) > 0, "the threshold must be at least one");
  assert(!(signerLeaves.size() < disclose(newThreshold)),
    "that would leave fewer signers than the threshold, and the account could never approve again");
  threshold = disclose(newThreshold);

  countRemoval();
  closeProposal(id);
}

// Opens a proposal at zero approvals: a run built from its parts, with the approvals its
// total needs, or a governance payload.
export circuit propose(
  payloadHash: Bytes<32>,
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  required: Uint<64>,
  isRun: Boolean,
  vault: Bytes<32>,
): [] {
  requireSigner();

  // The change and the id are computed once, for a run and a governance proposal alike.
  const salt = proposalSalt();
  const change = disclose(changeCommitmentOf(
    assetKeyOf(assetId(), assetBlinding()), changeAmount(), changeBatchDigest(), salt));
  const payload = disclose(isRun)
    ? runPayload(disclose(root), disclose(payees), disclose(opensAt), disclose(closesAt), disclose(required))
    : payloadHash;
  const id = disclose(proposalIdOf(payload, disclose(vault), salt));
  assert(!openProposals.member(id), "that proposal is already open");

  if (disclose(isRun)) {
  // A run needs payees, a window that opens before it closes, and a vault other than `noVault()`.
  assert(disclose(payees) > 0, "a run with no payees");
  assert(disclose(opensAt) < disclose(closesAt), "a run window ends before it opens");
  assert(disclose(vault) != noVault(), "a run must name the vault that will pay it");
  // The only place a window is written.
  runWindow.insert(id, Window { opensAt: disclose(opensAt), closesAt: disclose(closesAt) });
  } else {
  // A governance proposal names no vault, so no vault can ever be paid against it.
  assert(disclose(vault) == noVault(), "a governance proposal cannot name a vault");
  }

  openProposals.insert(id, change);
  approvalCounts.insert(id, 0);
  // The bar it was raised at, who may withdraw it, and the removals so far. A run's bar is
  // the higher of its vault's threshold and the approvals its total needs.
  proposalHolds.insert(id, Hold {
    needed: disclose(isRun) ? higher(thresholdFor(disclose(vault)), disclose(required)) : threshold,
    withdrawKey: disclose(withdrawKey(id)),
    removals: removalsSoFar(),
    runHold: default<RunHold>,
  });
}

// Adds the caller's approval to one open proposal. Refuses a second from the same signer.
export circuit approve(proposal: Bytes<32>): [] {
  const sk = requireSigner();
  const id = disclose(proposal);
  assert(openProposals.member(id), "there is no open proposal with that id");

  const nul = disclose(approvalNullifier(sk, id));
  assert(!approvals.member(nul), "you have already approved this proposal");

  approvals.insert(nul);
  approvalCounts.insert(id, (approvalCounts.lookup(id) + 1) as Uint<64>);
}

// Withdraws an open proposal: a run before its window by any signer, a governance
// proposal only by the signer who raised it.
export circuit cancel(proposal: Bytes<32>): [] {
  requireSigner();
  const id = disclose(proposal);
  assert(openProposals.member(id), "there is no open proposal with that id");

  if (runWindow.member(id)) {
    assert(blockTimeLt(runWindow.lookup(id).opensAt),
           "that run has already started; it can no longer be cancelled");
  } else {
    assert(disclose(withdrawKeyOf(withdrawSecret(id))) == holdOf(id).withdrawKey,
           "only the signer who raised this proposal can withdraw it");
  }

  closeProposal(id);
}

// Anyone may close a run whose window has passed. A governance proposal is not a run.
export circuit closeExpiredRun(proposal: Bytes<32>): [] {
  const id = disclose(proposal);
  assert(openProposals.member(id), "there is no open proposal with that id");
  assert(runWindow.member(id), "that is not a run");
  assert(blockTimeGte(runWindow.lookup(id).closesAt), "the payment window for this run has not closed yet");
  closeProposal(id);
}

// Records one payee of an approved run as paid, against the paying vault's receipt: one unit
// of `tokenType(paymentReceiptTag(), payingVault)`, minted by that vault to this account in
// the same transaction. Returns this account's address, which the vault mints to.
// A run names one vault, which must pay it; a company-wide run may be paid by any vault
// ever adopted whose own bar is not stricter than the company's and that has no spending
// policy. A vault with a spending policy pays only its own runs, and only once each is
// charged to its period. The amount and token are the ones the payee's path in the run's
// sum tree carries, so what a run pays is at most the total its root commits to.
export circuit recordPaymentFromVault(
  proposal: Bytes<32>,
  runVault: Bytes<32>,
  payingVault: Bytes<32>,
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  required: Uint<64>,
  salt: Bytes<32>,
  details: Bytes<32>,
  nonce: Bytes<32>,
  amount: Uint<128>,
  asset: Bytes<32>,
  path: Vector<16, SumStep>,
): ContractAddress {
  const id = disclose(proposal);
  const forRun = disclose(runVault);
  const payer = disclose(payingVault);

  // A governance proposal names no vault, so nothing can ever be paid against it.
  assert(forRun != noVault(), "a governance proposal pays nobody");

  // Only a contract this account adopted, now or before it was retired.
  assert(vaults.member(payer) || retiredAt.member(payer),
         "that contract is not a vault this company has adopted, so it cannot record a payment");

  const companyRun = forRun == companyWide();
  if (!companyRun) {
    assert(payer == forRun, "that run is for another vault");
  } else {
    // A vault whose own bar is stricter than the company's is never paid on the company's.
    assert(!(thresholds.member(payer) && threshold < thresholds.lookup(payer)),
           "that vault needs more approvals than the company's threshold; pay it through a run of its own");
  }

  // The receipt. With no mint behind it the token does not balance, and the transaction fails.
  receiveUnshielded(tokenType(paymentReceiptTag(), ContractAddress { bytes: payer }), 1);

  // The arguments must recompute this proposal's id, which needs its salt.
  assert(
    disclose(proposalIdOf(
      runPayload(disclose(root), disclose(payees), disclose(opensAt), disclose(closesAt), disclose(required)),
      forRun, disclose(salt)) == id),
    "that is not this proposal, or you were not given it");

  // Only inside the approved window.
  assert(blockTimeGte(disclose(opensAt)), "that run has not started yet");
  assert(blockTimeLt(disclose(closesAt)), "the payment window for this run has closed");

  // With the run's approvals: the highest of its bar when raised, the vault's today and the
  // approvals its total needs, plus one for every signer removed since.
  const change = requireApprovedForVault(id, forRun, disclose(required));

  // A vault under a spending policy pays only its own runs, each charged to its period first.
  if (signerRoles.member(disclose(policyOnKeyOf(payer)))) {
    assert(!companyRun,
           "that vault has a spending policy, so it pays only its own runs; raise this payment on a run for that vault");
    assert(change == clearedMark(),
           "that vault has a spending policy, so each run is charged to its period before it pays; charge this run to its period, then pay it");
  }

  // The payee must be a leaf of the approved run, at the amount and in the token its path
  // carries to the root; a company-wide leaf names its vault.
  const leaf = payoutLeaf(companyRun ? companyWideDetailsOf(details, payer) : details, nonce);
  assert(sumPathRoot(leaf, amount, path, asset) == root,
         "that payee is not in the approved run, at that amount and in that currency, from that vault");

  // Once ever, in any run.
  const movement = disclose(paidMovementOf(leaf));
  assert(!movements.member(movement), "that payment has already been made");
  movements.insert(movement);

  // And once for the person, month, kind and occurrence the nonce stands for, at any
  // amount, address or form. A real second payment is raised as a later occurrence.
  const once = disclose(paidOnceOf(nonce));
  assert(!movements.member(once),
         "a payment is already recorded for this person, kind of pay and month. Pay a real second payment as a numbered extra");
  movements.insert(once);

  return kernel.self();
}

// Seals the pay-record key to the calling signer: four parts under keys only they can derive.
// The first call also writes the account's commitment to the key, under an approved proposal;
// every later call must name the same commitment. Each signer seals their own copy, once.
export circuit sealPayKey(
  wrap: Vector<4, Bytes<32>>,
  commitment: Bytes<32>,
  proposal: Bytes<32>,
): [] {
  const sk = requireSigner();
  const account = kernel.self().bytes;

  if (!signerRoles.member(payKeyCommitmentKey())) {
    // Never first-come: the commitment is what every signer's approval named.
    const id = disclose(proposal);
    requireApproved(id);
    assert(
      disclose(proposalIdOf(payKeyPayload(commitment), noVault(), proposalSalt()) == proposal),
      "that proposal is not for this pay-record key"
    );
    assert(commitment != default<Bytes<32>>, "that is not a usable pay-record key");
    signerRoles.insert(payKeyCommitmentKey(), disclose(commitment));
    closeProposal(id);
  } else {
    assert(signerRoles.lookup(payKeyCommitmentKey()) == disclose(commitment),
           "that is not the pay-record key this company confirmed. Reopen your copy of the company's key and try again");
  }

  const first = disclose(payKeyWrapKeyOf(account, sk, 0));
  assert(!signerRoles.member(first), "you have already sealed the pay-record key to yourself");
  signerRoles.insert(first, disclose(wrap[0]));
  signerRoles.insert(disclose(payKeyWrapKeyOf(account, sk, 1)), disclose(wrap[1]));
  signerRoles.insert(disclose(payKeyWrapKeyOf(account, sk, 2)), disclose(wrap[2]));
  signerRoles.insert(disclose(payKeyWrapKeyOf(account, sk, 3)), disclose(wrap[3]));
}

// Sets one vault's threshold under an approved proposal. Refuses zero; the vault need not be adopted.
export circuit setVaultThreshold(
  vault: Bytes<32>,
  newThreshold: Uint<64>,
  proposal: Bytes<32>,
): [] {
  requireSigner();
  const id = disclose(proposal);
  assert(
    disclose(proposalIdOf(
      setVaultThresholdPayload(vault, newThreshold), noVault(), proposalSalt()) == id),
    "that proposal does not authorise this vault threshold");
  requireApproved(id);

  assert(!(newThreshold == 0), "a vault threshold of zero would authorise anything");
  assert(disclose(vault) != companyWide(), "the company-wide decision always takes the account's threshold");
  thresholds.insert(disclose(vault), disclose(newThreshold));
  closeProposal(id);
}

// Adds a vault to the register under an approved proposal. Refuses one already there.
export circuit adopt(vault: Bytes<32>, proposal: Bytes<32>): [] {
  requireSigner();
  const id = disclose(proposal);
  assert(
    disclose(proposalIdOf(
      adoptVaultPayload(vault), noVault(), proposalSalt()) == id),
    "that proposal does not authorise adopting this vault");
  requireApproved(id);

  assert(!vaults.member(disclose(vault)), "this account has already adopted that vault");
  vaults.insert(disclose(vault));
  closeProposal(id);
}

// Unregisters a vault and marks it retired, on an approved proposal and its salt. No caller check.
export circuit retireVault(
  proposal: Bytes<32>,
  vault: Bytes<32>,
  salt: Bytes<32>,
): [] {
  const id = disclose(proposal);
  const forVault = disclose(vault);
  assert(
    disclose(proposalIdOf(retireVaultPayload(forVault), noVault(), disclose(salt)) == id),
    "that proposal does not authorise retiring this vault");
  requireApproved(id);
  assert(vaults.member(forVault), "this account has not adopted that vault");
  vaults.remove(forVault);
  retiredAt.insert(forVault, 1);
  closeProposal(id);
}

// Sets one vault's spending policy for one currency under an approved proposal: the policy's
// commitment under a key derived here from the vault and the currency, and the marker that the
// vault is under a policy. It needs the higher of the account's bar and the bar the company
// set for policy changes.
export circuit setPolicy(
  vault: Bytes<32>,
  commitment: Bytes<32>,
  proposal: Bytes<32>,
): [] {
  requireSigner();
  const id = disclose(proposal);
  const forVault = disclose(vault);
  const assetKey = assetKeyOf(assetId(), assetBlinding());
  assert(
    disclose(proposalIdOf(
      setPolicyPayload(forVault, assetKey, commitment), noVault(), proposalSalt()) == id),
    "that proposal does not authorise this policy");
  requireApproved(id);
  assert(!(approvalCounts.lookup(id) < thresholdFor(policyBarKey())),
    "a change to a spending policy needs the approvals the company set for policy changes");

  assert(forVault != noVault(), "a policy needs a vault");
  assert(forVault != companyWide(), "a policy is set on one vault, not on the company");
  assert(forVault != policyBarKey(), "a policy is set on one vault");
  assert(commitment != default<Bytes<32>>, "that is not a usable policy");

  signerRoles.insert(disclose(policyKeyOf(forVault, assetKey)), disclose(commitment));
  signerRoles.insert(disclose(policyOnKeyOf(forVault)), policyOnMark());
  closeProposal(id);
}

// Charges an approved run to its vault's period, once, inside its window. Refuses a run not
// approved at the bar it needs, outside its window, already charged, paying a token its
// vault has no policy for, needing more approvals than it was raised with, whose window
// leaves the period, or taking the period past its limit. A run raised again over the same
// tree in the same period is marked cleared without being charged again.
export circuit clearRun(
  proposal: Bytes<32>,
  vault: Bytes<32>,
  root: Bytes<32>,
  payees: Uint<64>,
  opensAt: Uint<64>,
  closesAt: Uint<64>,
  required: Uint<64>,
  salt: Bytes<32>,
  top: Field,
  total: Uint<128>,
  period: Uint<64>,
): [] {
  const id = disclose(proposal);
  const forVault = disclose(vault);
  const forRoot = disclose(root);
  assert(
    disclose(proposalIdOf(
      runPayload(forRoot, disclose(payees), disclose(opensAt), disclose(closesAt), disclose(required)),
      forVault, disclose(salt)) == id),
    "that is not this run, or you were not given it");

  // Only once its window has opened, so a run that can still be withdrawn is never charged.
  assert(blockTimeGte(disclose(opensAt)), "that run has not started yet, so it cannot be charged to a period");
  assert(blockTimeLt(disclose(closesAt)), "the payment window for this run has closed");

  // Only at the bar it needs, so no signer can charge a period alone.
  const change = requireApprovedForVault(id, forVault, disclose(required));
  assert(change != clearedMark(), "that run has already been charged to its period");

  // The total and token the run's root commits to are the ones the policy is looked up by.
  const asset = assetId();
  assert(sumRootOf(top, total, asset) == forRoot,
         "that total or currency is not the one the signers approved for this run");

  const policyKey = disclose(policyKeyOf(forVault, assetKeyOf(asset, assetBlinding())));
  assert(signerRoles.member(policyKey),
         "this vault has no spending policy for the currency this run pays in, so there is nothing to charge the run to; a vault with no policy at all is paid without a charge, and one with a policy for another currency needs a policy set for this one first");
  const commitment = signerRoles.lookup(policyKey);
  const policy = policyOpening();
  assert(policyCommitmentOf(policy) == commitment, "that is not this vault's current policy for this currency; get the current policy and try again");

  // The band its total falls in, against the approvals it was raised with.
  assert(!(disclose(required) < bandApprovals(policy.terms.bands, total)),
         "this run's total needs more approvals than it was raised with; raise it again with the approvals its band needs");

  // The period is the one its whole window lies in.
  const starts = policy.terms.periodStart + disclose(period) * policy.terms.periodLength;
  assert(!(disclose(opensAt) < starts), "that run's window starts before the period it is charged to; if its window crosses two periods, raise the run again inside one");
  assert(!(starts + policy.terms.periodLength < disclose(closesAt)),
         "that run's window ends after the period it is charged to; if its window crosses two periods, raise the run again inside one");

  const periodKey = disclose(periodKeyOf(policyKey, commitment, disclose(period)));
  const blinding = periodBlindingOf(policy.blinding, disclose(period));
  const spent = periodSpent();
  if (signerRoles.member(periodKey)) {
    assert(signerRoles.lookup(periodKey) == periodTotalOf(spent, blinding),
           "that is not what this vault has spent in the period; refresh the total for the period on this device and try again");
  } else {
    assert(spent == 0, "this device says the vault has spent something this period, but the account has nothing charged to it; refresh the total for the period and try again");
  }

  const charged = disclose(chargedKeyOf(periodKey, forRoot));
  if (!signerRoles.member(charged)) {
    const after = (spent + total) as Uint<128>;
    assert(!(policy.terms.periodLimit < after),
           "this run would take the vault past its limit for the period; pay it in a later period, pay less, or raise the limit for the period");
    signerRoles.insert(periodKey, disclose(periodTotalOf(after, blinding)));
    signerRoles.insert(charged, chargedMark());
  }

  openProposals.insert(id, clearedMark());
}
