{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "types": ["node"],
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
